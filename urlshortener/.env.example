# Copy to .env (or export these) before running with non-default values.
# .env itself is gitignored — never commit real secrets.

# Required on POST/DELETE endpoints via the X-API-Key header.
# Falls back to a dev-only default (see application.yml) if unset — fine for local
# exploration, not something you'd ever do in a real deployment.
API_KEY=change-me-local-dev-key

# Postgres connection - defaults match docker-compose.yml's postgres service, so
# `docker compose up -d` + `./mvnw spring-boot:run` works with zero setup. Override
# these to point at a different Postgres instance.
DB_URL=jdbc:postgresql://localhost:5432/urlshortener
DB_USERNAME=urlshortener
DB_PASSWORD=urlshortener
